# ===================== QQ 机器人（q.qq.com → 开发设置） =====================
QQ_APP_ID=
QQ_APP_SECRET=

# 允许使用机器人的用户 ID，逗号分隔；填 * 表示所有人。
# 这里的 ID 不是 QQ 号，而是机器人视角的 openid：给机器人发 /whoami 就能看到，控制台日志里也会打印。
# 注意：同一个人在单聊和群聊里的 ID 可能不同，两个都要加。
# ⚠️ 被允许的人可以让 Codex 在这台电脑上执行命令，只加你信任的人。
QQ_ALLOWED_USERS=
# 允许整个群使用（群 openid，逗号分隔；* 表示所有群）。群里任何人 @机器人 都能用。
QQ_ALLOWED_GROUPS=

# 订阅的事件，逗号分隔。可选：GROUP_AND_C2C_EVENT, PUBLIC_GUILD_MESSAGES, DIRECT_MESSAGE, GUILD_MESSAGES ...
QQ_INTENTS=GROUP_AND_C2C_EVENT,PUBLIC_GUILD_MESSAGES
# Markdown：auto=先尝试 Markdown，没权限就自动退回纯文本；on=只用 Markdown；off=只用纯文本
QQ_MARKDOWN=auto
# 是否把 Codex 的中间进度（例如“我先看看目录结构”）转发到 QQ
QQ_PROGRESS=true
# 群聊会话：shared=全群共用一个 Codex 会话；user=群里每人各自一个会话
QQ_GROUP_SESSION=shared
# 单条消息最大字符数 / 一次回复最多拆成几条（超出部分会存到 data/replies）
QQ_MAX_CHUNK_CHARS=1800
QQ_MAX_CHUNKS=5
# OpenAPI 域名，一般不用改
# QQ_API_BASE=https://api.bot.qq.com

# ================================ Codex ================================
# codex 可执行文件；留空会自动查找 npm 全局安装的 codex
CODEX_BIN=
# Codex 的工作目录（相对路径基于本项目目录）
CODEX_CWD=./workspace
# 以下留空 = 沿用 ~/.codex/config.toml 里的设置
CODEX_MODEL=
# 推理强度：low | medium | high | xhigh
CODEX_EFFORT=
# 沙箱：read-only | workspace-write | danger-full-access
CODEX_SANDBOX=
# 审批策略：QQ 里没法点“同意”，保持 never（需要审批的操作会被自动拒绝）
CODEX_APPROVAL_POLICY=never
# 追加给 Codex 的额外指令（人设、规则等），会接在内置的 QQ 场景说明后面
CODEX_INSTRUCTIONS=
# 同时运行的 Codex 任务上限 / 单个任务超时（分钟）
CODEX_MAX_CONCURRENT=3
CODEX_TURN_TIMEOUT_MIN=30

# ================================ 其他 ================================
DATA_DIR=./data
# debug | info | warn | error
LOG_LEVEL=info
